# Kensaku for PowerToys Command Palette
# Windows-only .NET 10 / MSIX project. Kept deliberately short: everything
# below is either generated output or machine-local state.

# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/
artifacts/
Generated\ Files/
*.obj
*.pdb
*.ilk
*.log
*.tlog
*.binlog
*.tmp
*.[Cc]ache
!?*.[Cc]ache/

# MSIX packaging output
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload
*.msix
*.msixbundle
*.msixupload
*.msm
*.msp
*.cab
publish/
*.nupkg
*.snupkg

# Visual Studio / editor state
.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.VC.db
*.VC.VC.opendb
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/
*.sln.iml
.history/

# Publish profiles: *.pubxml is normally ignored, but ours are committed so CI
# can resolve the RuntimeIdentifier (win-x64 / win-arm64).
*.pubxml
*.publishproj
*.azurePubxml
!KensakuCmdPal/Properties/PublishProfiles/*.pubxml

# Secrets and signing material
.env
*.pfx
*.publishsettings

# Release downloads and local packages. The canonical public certificate is the
# tracked kensaku.cer at the repo root; every other copy is a generated artifact.
rel/
**/kensaku.cer
!/kensaku.cer

# OS cruft
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
._*
*.lnk
*.swp
*~
~$*

# WorkBuddy agent state (session notes, not project source)
.workbuddy-ai/
